{
  "name": "narrativerebuild",
  "private": true,
  "version": "0.1.0",
  "description": "NarrativeRebuild — structured expressive-writing platform (Pennebaker-style)",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client && npm run install:nlp",
    "install:nlp": "python -m pip install -r nlp/requirements.txt",
    "dev": "concurrently -n nlp,server,client -c cyan,yellow,green \"npm:dev:nlp\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:nlp": "python nlp/src/pronoun_analyzer.py",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "typecheck": "npm run typecheck --prefix server && npm run typecheck --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
