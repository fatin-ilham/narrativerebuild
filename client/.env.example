# NarrativeRebuild web client configuration
# Copy to `.env` to override defaults. All values are optional.

# Where the Node backend (real-time + API) lives.
# Default: http://localhost:4000
# VITE_BACKEND_URL=http://localhost:4000

# Where the Node backend lives for the Socket.io real-time layer.
# Default: http://localhost:4000
# VITE_SOCKET_URL=http://localhost:4000
